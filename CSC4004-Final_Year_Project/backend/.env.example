SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-bytes
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Local development defaults to SQLite. For MySQL, set DB_ENGINE to django.db.backends.mysql.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
